<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nino - Discord Music Bot</title>
  <meta name="description" content="Nino — a Discord music bot inspired by Nakano Nino. Play music from Spotify and SoundCloud in your server.">
  <meta name="theme-color" content="#E84393">
  <link rel="icon" href="https://cdn.discordapp.com/avatars/1135180841341964288/2cef5503cac860cc6407a17b9421066e?size=256" type="image/png">

  <!-- Open Graph -->
  <meta property="og:title" content="Nino - Discord Music Bot">
  <meta property="og:description" content="A Discord music bot inspired by Nakano Nino from The Quintessential Quintuplets.">
  <meta property="og:image" content="https://cdn.discordapp.com/avatars/1135180841341964288/2cef5503cac860cc6407a17b9421066e?size=256">
  <meta property="og:type" content="website">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --nino-pink: #E84393;
      --nino-pink-light: #FD79A8;
      --nino-pink-dark: #C0357A;
      --nino-purple: #9B59B6;
      --nino-ribbon: #FF6B9D;
      --spotify-green: #1DB954;
      --soundcloud-orange: #FF5500;
      --text-primary: #ffffff;
      --text-secondary: #d4b8c4;
      --card-bg: rgba(35, 18, 28, 0.72);
      --card-border: rgba(232, 67, 147, 0.15);
    }

    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-primary);
      min-height: 100vh;
      line-height: 1.6;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        linear-gradient(160deg, rgba(15, 6, 12, 0.94) 0%, rgba(35, 15, 28, 0.88) 45%, rgba(15, 6, 12, 0.92) 100%),
        url('/images/nino-alt.jpg') center / cover no-repeat fixed;
      z-index: -2;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 20%, rgba(232, 67, 147, 0.18) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(155, 89, 182, 0.12) 0%, transparent 50%);
      z-index: -1;
      pointer-events: none;
    }

    .butterfly {
      position: fixed;
      font-size: 1.2rem;
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
      animation: float 8s ease-in-out infinite;
    }

    .butterfly:nth-child(1) { top: 15%; left: 8%; animation-delay: 0s; }
    .butterfly:nth-child(2) { top: 60%; left: 5%; animation-delay: 2s; font-size: 1rem; }
    .butterfly:nth-child(3) { top: 30%; right: 10%; animation-delay: 4s; }
    .butterfly:nth-child(4) { top: 75%; right: 15%; animation-delay: 1s; font-size: 0.9rem; }
    .butterfly:nth-child(5) { top: 45%; left: 50%; animation-delay: 3s; font-size: 1.4rem; }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(5deg); }
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    nav {
      padding: 18px 0;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(15, 6, 12, 0.82);
      backdrop-filter: blur(14px);
      z-index: 100;
      border-bottom: 1px solid var(--card-border);
    }

    nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--nino-pink-light);
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--nino-pink);
      box-shadow: 0 0 16px rgba(232, 67, 147, 0.4);
    }

    .nav-links {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--nino-pink-light);
    }

    .hero {
      padding: 140px 0 80px;
      text-align: center;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(232, 67, 147, 0.15);
      border: 1px solid rgba(232, 67, 147, 0.3);
      color: var(--nino-pink-light);
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5vw, 3.75rem);
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.1;
      background: linear-gradient(135deg, #fff 0%, var(--nino-pink-light) 60%, var(--nino-purple) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.1rem;
      color: var(--nino-pink-light);
      font-weight: 500;
      margin-bottom: 16px;
      opacity: 0.9;
    }

    .hero p {
      font-size: 1.1rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto 36px;
    }

    .cta-buttons {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 28px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--nino-pink), var(--nino-pink-dark));
      color: white;
      box-shadow: 0 4px 24px rgba(232, 67, 147, 0.45);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 32px rgba(232, 67, 147, 0.55);
    }

    .btn-secondary {
      background: var(--card-bg);
      color: var(--text-primary);
      border: 1px solid var(--card-border);
      backdrop-filter: blur(8px);
    }

    .btn-secondary:hover {
      border-color: rgba(232, 67, 147, 0.4);
    }

    .features {
      padding: 80px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-title h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      background: linear-gradient(135deg, #fff, var(--nino-pink-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .section-title p {
      color: var(--text-secondary);
      font-size: 1.1rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .feature-card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      border-radius: 16px;
      padding: 32px;
      border: 1px solid var(--card-border);
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      border-color: rgba(232, 67, 147, 0.35);
      box-shadow: 0 8px 32px rgba(232, 67, 147, 0.12);
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 20px;
    }

    .feature-icon.spotify {
      background: rgba(29, 185, 84, 0.15);
    }

    .feature-icon.soundcloud {
      background: rgba(255, 85, 0, 0.15);
    }

    .feature-icon.commands {
      background: rgba(232, 67, 147, 0.15);
    }

    .feature-icon.quality {
      background: rgba(155, 89, 182, 0.15);
    }

    .feature-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .feature-card p {
      color: var(--text-secondary);
    }

    .commands-section {
      padding: 80px 0;
    }

    .commands-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      max-width: 900px;
      margin: 0 auto;
    }

    .command {
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      border-radius: 12px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 16px;
      border: 1px solid var(--card-border);
      transition: border-color 0.2s;
    }

    .command:hover {
      border-color: rgba(232, 67, 147, 0.3);
    }

    .command-name {
      font-family: 'SF Mono', 'Fira Code', monospace;
      background: rgba(232, 67, 147, 0.15);
      color: var(--nino-pink-light);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .command-desc {
      color: var(--text-secondary);
      font-size: 0.95rem;
      white-space: nowrap;
    }

    .cta {
      padding: 80px 0 100px;
      text-align: center;
    }

    .cta-box {
      background: linear-gradient(135deg, var(--nino-pink-dark), var(--nino-purple));
      border-radius: 24px;
      padding: 60px 40px;
      max-width: 800px;
      margin: 0 auto;
      box-shadow: 0 16px 48px rgba(232, 67, 147, 0.3);
    }

    .cta-box h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .cta-box p {
      font-size: 1.1rem;
      opacity: 0.9;
      margin-bottom: 32px;
    }

    .cta-box .btn-primary {
      background: white;
      color: var(--nino-pink-dark);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    footer {
      padding: 40px 0;
      text-align: center;
      border-top: 1px solid var(--card-border);
    }

    footer p {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    footer a {
      color: var(--nino-pink-light);
      text-decoration: none;
    }

    footer .attribution {
      margin-top: 8px;
      font-size: 0.8rem;
      opacity: 0.6;
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }

      .hero {
        padding: 120px 0 60px;
      }

      .commands-list {
        grid-template-columns: 1fr;
      }

      .command-desc {
        white-space: normal;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .btn {
        width: 100%;
        max-width: 300px;
        justify-content: center;
      }
    }

    @media (max-width: 600px) {
      .commands-list {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <span class="butterfly" aria-hidden="true">🦋</span>
  <span class="butterfly" aria-hidden="true">🦋</span>
  <span class="butterfly" aria-hidden="true">🦋</span>
  <span class="butterfly" aria-hidden="true">🦋</span>
  <span class="butterfly" aria-hidden="true">🦋</span>

  <nav>
    <div class="container">
      <div class="logo">
        <img class="logo-icon" src="https://cdn.discordapp.com/avatars/1135180841341964288/2cef5503cac860cc6407a17b9421066e?size=256" alt="Nino">
        <span>Nino</span>
      </div>
      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#commands">Commands</a></li>
        <li><a href="https://github.com/aeonamind/sound-bot" target="_blank">GitHub</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div class="container">
        <span class="hero-badge">The Quintessential Quintuplets</span>
        <h1>Your Server's DJ</h1>
        <p class="hero-subtitle">Nakano Nino · 中野二乃</p>
        <p>A Discord music bot with Nino's signature style — play music from Spotify and SoundCloud with simple commands and bring the party to your server.</p>
        <div class="cta-buttons">
          <a class="btn btn-primary" href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=3147776&scope=bot%20applications.commands">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Add to Discord
          </a>
          <a href="#commands" class="btn btn-secondary">View Commands</a>
        </div>
      </div>
    </section>

    <section class="features" id="features">
      <div class="container">
        <div class="section-title">
          <h2>Why Nino?</h2>
          <p>Everything you need for the perfect music experience</p>
        </div>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon spotify">🎧</div>
            <h3>Spotify Integration</h3>
            <p>Play your favorite tracks, albums, and playlists directly from Spotify URLs.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon soundcloud">☁️</div>
            <h3>SoundCloud Support</h3>
            <p>Discover and play tracks from SoundCloud's vast library of independent artists.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon commands">⚡</div>
            <h3>Simple Commands</h3>
            <p>Easy-to-use slash commands that anyone in your server can use right away.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon quality">🔊</div>
            <h3>High Quality Audio</h3>
            <p>Crystal clear audio streaming with adjustable volume controls.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="commands-section" id="commands">
      <div class="container">
        <div class="section-title">
          <h2>Commands</h2>
          <p>All the controls you need at your fingertips</p>
        </div>
        <div class="commands-list">
          <div class="command">
            <span class="command-name">/music play</span>
            <span class="command-desc">Play a song or playlist</span>
          </div>
          <div class="command">
            <span class="command-name">/music pause</span>
            <span class="command-desc">Pause playback</span>
          </div>
          <div class="command">
            <span class="command-name">/music resume</span>
            <span class="command-desc">Resume playback</span>
          </div>
          <div class="command">
            <span class="command-name">/music skip</span>
            <span class="command-desc">Skip current song</span>
          </div>
          <div class="command">
            <span class="command-name">/music stop</span>
            <span class="command-desc">Stop and clear queue</span>
          </div>
          <div class="command">
            <span class="command-name">/music queue</span>
            <span class="command-desc">View the queue</span>
          </div>
          <div class="command">
            <span class="command-name">/music volume</span>
            <span class="command-desc">Adjust volume (1-100)</span>
          </div>
          <div class="command">
            <span class="command-name">/music shuffle</span>
            <span class="command-desc">Shuffle the queue</span>
          </div>
          <div class="command">
            <span class="command-name">/music nowplaying</span>
            <span class="command-desc">Show current track</span>
          </div>
          <div class="command">
            <span class="command-name">!play</span>
            <span class="command-desc">Legacy prefix command</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <h2>Ready to bring music to your server?</h2>
          <p>Add Nino now and start playing your favorite tracks in seconds.</p>
          <a class="btn btn-primary" href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=3147776&scope=bot%20applications.commands">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Add to Discord
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>Made with ❤️ for Discord communities</p>
      <p class="attribution">The Quintessential Quintuplets © Kodansha / Negi Haruba</p>
    </div>
  </footer>
</body>
</html>
