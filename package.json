{
	"name": "sound-bot",
	"version": "0.0.1",
	"description": "Discord music bot powered by Bun",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"module": "src/index.ts",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"start:debug": "bun --inspect --watch src/index.ts",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@discord-player/extractor": "^7.1.0",
		"@discordjs/voice": "^0.18.0",
		"discord-api-types": "^0.38.0",
		"discord-player": "^7.1.0",
		"discord-player-soundcloud": "^1.0.7",
		"discord-player-spotify": "https://github.com/hmes98318/discord-player-spotify#master",
		"discord.js": "^14.25.1",
		"ejs": "^4.0.1",
		"ffmpeg-static": "^5.3.0",
		"glob": "^13.0.1",
		"libsodium-wrappers": "^0.7.11",
		"mediaplex": "^1.0.0",
		"opusscript": "^0.1.1",
		"play-dl": "^1.9.7",
		"youtube-dl-exec": "^3.1.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/bun": "^1.3.14",
		"@types/ejs": "^3.1.5",
		"@types/glob": "^9.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.3",
		"typescript": "^5.1.3"
	},
	"trustedDependencies": [
		"discord-player-spotify",
		"youtube-dl-exec"
	]
}
